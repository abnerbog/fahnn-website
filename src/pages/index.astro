---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { ORG, MARKET, STORY } from '~/data/site';
import { MILESTONES } from '~/data/milestones';
import { PROGRAMS } from '~/data/programs';
import { PARTNERS } from '~/data/partners';
import { pressUrl } from '~/data/press';
import { getPermalink } from '~/utils/permalinks';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

import marketInside from '~/assets/images/farmers_market_inside.png';
import marketOutside from '~/assets/images/farmers_market_outside.png';
import marketSign from '~/assets/images/farmers_market_sign.png';
import marketRhonda from '~/assets/images/farmers_market_rhonda.png';
import valleyPlazaSign from '~/assets/images/valley_plaza_sign.png';

// The home page tells Our Story; the header's "Our Story" link points here.
const metadata = {
  title: `${ORG.name} | Fresh food and health in Syracuse’s Valley/Southside`,
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`).
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

// Links to the article that covered the grant, once we have its URL.
const investment = `a ${STORY.groceryGrantAmount} grant to bring a grocery store back to Valley Plaza`;
const investmentUrl = pressUrl('meet-aunt-rhonda');
const investmentText = investmentUrl
  ? `<a href="${investmentUrl}" target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-4">${investment}<span class="sr-only"> (opens Syracuse.com in a new tab)</span></a>`
  : investment;
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1. Hero: the market brings the neighborhood together ************ -->

  <section class="relative isolate not-prose overflow-hidden bg-black">
    <Image
      src={marketInside}
      alt="Fresh bok choy, apples, pumpkins, and mushrooms on a market table, with neighbors and children gathered at tables in the room behind."
      layout="cover"
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      width={2400}
      height={1600}
      loading="eager"
      fetchpriority="high"
      format="webp"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[center_30%]"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 via-black/35 to-black/0" aria-hidden="true"></div>
    <div
      class="mx-auto flex min-h-[32rem] max-w-7xl flex-col justify-end px-4 pt-48 pb-6 md:min-h-[44rem] md:px-6 md:pb-8 lg:min-h-[min(80vh,56rem)]"
    >
      <h1
        class="max-w-3xl font-heading text-5xl leading-tighter font-bold tracking-tighter text-balance text-white md:text-7xl"
      >
        Good food. Good health. Good neighbors.
      </h1>
      <p class="mt-6 max-w-2xl text-xl text-pretty text-white/90 md:text-2xl">
        On market day in Syracuse’s Valley/Southside, neighbors come together over fresh food and good health. This is
        how a neighborhood that lost its grocery store started bringing both back.
      </p>
    </div>
  </section>

  <!-- 2. How it started ************ -->

  <WidgetWrapper id="how-it-started">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="text-base font-bold tracking-wide text-secondary uppercase">How it started</p>
        <h2
          class="mt-2 font-heading text-3xl leading-tighter font-bold tracking-tighter text-balance text-heading md:text-4xl"
        >
          In {STORY.groceryClosedYear}, the grocery store closed. In {STORY.foundedYear}, neighbors started {
            ORG.shortName
          }.
        </h2>
        <div class="mt-6 space-y-4 text-lg text-pretty">
          <p>
            Tops at Valley Plaza was our neighborhood’s only full-service grocery store. When it closed, there was no
            full-service grocery store left within {STORY.noGroceryRadius}. Neighbors were left buying groceries at
            dollar stores and corner stores.
          </p>
          <p>
            That didn’t just happen. Decisions about where stores open and close, and where money is invested, left our
            neighborhood behind.
          </p>
          <p>
            So longtime residents stopped waiting. They set up a weekly farmers market in the Plaza parking lot, right
            outside the empty store, and took neighbors’ voices to the people making decisions.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 md:gap-6 lg:col-span-7">
        <figure>
          <Image
            src={valleyPlazaSign}
            alt="The tall Valley Plaza sign on South Salina Street. The faded outline of the old Tops logo is still visible at the top."
            widths={[320, 480, 720]}
            sizes="(max-width: 1023px) 50vw, 360px"
            width={720}
            height={1080}
            layout="constrained"
            format="webp"
            class="aspect-[2/3] w-full rounded-2xl object-cover shadow-lg"
          />
          <figcaption class="mt-3 text-sm text-muted">
            The Tops logo has faded from the Valley Plaza sign, but people haven’t forgotten what was lost.
          </figcaption>
        </figure>
        <figure class="mt-10 md:mt-16">
          <Image
            src={marketRhonda}
            alt="A woman stands under a green market tent behind a table of tomatoes, peppers, and potatoes, with the Valley Plaza storefronts across the parking lot."
            widths={[320, 480, 720]}
            sizes="(max-width: 1023px) 50vw, 360px"
            width={720}
            height={1080}
            layout="constrained"
            format="webp"
            class="aspect-[2/3] w-full rounded-2xl object-cover shadow-lg"
          />
          <figcaption class="mt-3 text-sm text-muted">
            Executive Director Rhonda Vesey at the FAHNN market in the Valley Plaza parking lot.
          </figcaption>
        </figure>
      </div>
    </div>
  </WidgetWrapper>

  <!-- 3. The FAHNN Farmers Market ************************************* -->

  <WidgetWrapper id="market">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>
    <div>
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="text-base font-bold tracking-wide text-secondary uppercase">{MARKET.name}</p>
          <h2
            class="mt-2 font-heading text-3xl leading-tighter font-bold tracking-tighter text-balance text-heading md:text-4xl"
          >
            Fresh, local food, right in the neighborhood.
          </h2>
          <p class="mt-4 text-lg text-pretty">
            Local farmers sell fresh, healthy food. Neighbors shop with SNAP, catch up with friends, and meet the people
            who grow what they eat.
          </p>
        </div>
        <ul class="space-y-3 text-lg lg:col-span-5">
          <li class="flex items-center gap-3">
            <Icon name="tabler:calendar-event" class="h-6 w-6 shrink-0 text-secondary" aria-hidden="true" />
            <span><strong>{MARKET.days}</strong>, {MARKET.hours}</span>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="tabler:map-pin" class="h-6 w-6 shrink-0 text-secondary" aria-hidden="true" />
            <a
              href={ORG.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-link underline underline-offset-4"
            >
              {ORG.fullAddress}<span class="sr-only"> (opens Google Maps in a new tab)</span>
            </a>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="tabler:circle-check" class="h-6 w-6 shrink-0 text-secondary" aria-hidden="true" />
            <span>{MARKET.payment}</span>
          </li>
        </ul>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <Image
          src={marketOutside}
          alt="An older woman reaches for tomatoes as a farmer in a yellow cap hands her red peppers across a market table."
          widths={[400, 640, 960, 1280]}
          sizes="(max-width: 767px) 100vw, 50vw"
          width={1280}
          height={853}
          layout="constrained"
          format="webp"
          class="aspect-[3/2] w-full rounded-2xl object-cover"
        />
        <Image
          src={marketSign}
          alt="A sidewalk sign with balloons on South Salina Street reads FAHNN’s Farmers Market at Valley Plaza, Saturdays 8 a.m. to 2 p.m., SNAP accepted."
          widths={[400, 640, 960, 1280]}
          sizes="(max-width: 767px) 100vw, 50vw"
          width={1280}
          height={853}
          layout="constrained"
          format="webp"
          class="aspect-[3/2] w-full rounded-2xl object-cover"
        />
      </div>
    </div>
  </WidgetWrapper>

  <!-- 4. More than a market: FAHNN's other programs ******************** -->

  <WidgetWrapper id="programs">
    <Headline
      tagline="More than a market"
      title="Food and health, all year long."
      subtitle="With our partners, we bring neighbors together to learn, eat well, and look out for each other."
      classes={{ container: 'max-w-3xl' }}
    />
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        PROGRAMS.map(({ id, name, description, icon }) => (
          <li class="flex flex-col rounded-2xl border border-black/10 p-6 dark:border-white/10">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-surface text-secondary">
              <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-4 text-xl font-bold text-heading">
              <a href={getPermalink(`/what-we-do#${id}`)} class="hover:underline">
                {name}
              </a>
            </h3>
            <p class="mt-2 text-lg text-pretty text-muted">{description}</p>
          </li>
        ))
      }
    </ul>
    <div class="mt-10 text-center">
      <Button
        variant="secondary"
        text="See everything we do"
        href={getPermalink('/what-we-do')}
        icon="tabler:arrow-right"
      />
    </div>
  </WidgetWrapper>

  <!-- 5. What changed: the investment followed ************************ -->

  <Timeline
    id="what-changed"
    layout="alternate"
    tagline="What changed"
    title="We showed up every week. The investment followed."
    subtitle={`Years of busy market days proved what our neighborhood needs. ${ORG.shortName} was a catalyst for ${investmentText}, and that momentum is bringing health care back too.`}
    items={MILESTONES}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>
    <Button variant="secondary" text="See FAHNN in the news" href={getPermalink('/news')} icon="tabler:arrow-right" />
  </Timeline>

  <!-- 6. Partners ***************************************************** -->

  <WidgetWrapper id="partners">
    <Headline
      tagline="Our partners"
      title="We don’t do this alone."
      subtitle="Farms, schools, city leaders, and community groups help us bring food and health to the Valley/Southside."
      classes={{ container: 'max-w-3xl' }}
    />
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6">
      {
        PARTNERS.map(({ src, alt, href }) => {
          const logo = (
            <Image
              src={src}
              alt={alt ?? ''}
              height={96}
              widths={[192, 384]}
              sizes="192px"
              layout="none"
              format="webp"
              class="h-16 w-auto max-w-full object-contain md:h-20"
            />
          );
          return (
            <li class="flex h-28 items-center justify-center rounded-2xl bg-white p-4 ring-1 ring-black/10 md:h-36 md:p-6">
              {href ? (
                <a href={href} target="_blank" rel="noopener noreferrer">
                  {logo}
                </a>
              ) : (
                logo
              )}
            </li>
          );
        })
      }
    </ul>
    <div class="mt-10 text-center">
      <Button variant="secondary" text="Meet our people" href={getPermalink('/our-people')} icon="tabler:arrow-right" />
    </div>
  </WidgetWrapper>

  <!-- Next step ****************************************************** -->

  <CallToAction
    layout="banner"
    title="This is just the beginning."
    subtitle="Come to the market, lend a hand, or give, and help build what comes next."
    actions={[
      { variant: 'primary', text: 'Get involved', href: getPermalink('/get-involved') },
      { text: 'Donate', href: getPermalink('/donate') },
    ]}
  />
</Layout>
