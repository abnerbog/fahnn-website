---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import PhotoHero from '~/components/widgets/PhotoHero.astro';

import { ORG, STORY } from '~/data/site';
import { BOARD, STAFF } from '~/data/people';
import { getPermalink } from '~/utils/permalinks';

import marketOverview from '~/assets/images/farmers_market_overview.png';

const metadata = {
  title: 'Our People',
  description: `${ORG.shortName} is a team of staff, a Board of Directors, and volunteers from Syracuse’s Valley/Southside and beyond, working together for good food and good health.`,
};

// The Executive Director leads the staff section; any other staff follow as cards.
const [lead, ...otherStaff] = STAFF;

const VOLUNTEER_ROLES = [
  {
    icon: 'tabler:tent',
    title: 'Setting up',
    description: 'Putting up tents, tables, and signs before the market opens.',
  },
  {
    icon: 'tabler:box',
    title: 'Packing up',
    description: 'Taking it all down and packing it away when the day is done.',
  },
  {
    icon: 'tabler:heart-handshake',
    title: 'Lending a hand',
    description: `Pitching in at ${ORG.shortName}’s other programs and events all year long.`,
  },
];
---

<Layout metadata={metadata}>
  <!-- 1. Hero: it takes a neighborhood ********************************* -->

  <PhotoHero
    image={marketOverview}
    alt="Market tents and tables in the Valley Plaza parking lot on a sunny fall day. Neighbors shop at the stalls, with the empty store and an apartment tower behind."
    title="It takes a neighborhood."
    focus="25% 85%"
  >
    {ORG.shortName} is a team: staff, a Board of Directors, and volunteers from the Valley/Southside and across greater Syracuse.
    Everything we’ve built, we built together. Everything ahead will take all of us.
  </PhotoHero>

  <!-- 2. Staff: the groundwork, and the team that builds on it ********** -->

  {
    lead && (
      <WidgetWrapper id="staff">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <figure class="lg:col-span-7">
            <Image
              src={lead.image}
              alt={lead.alt}
              widths={[400, 640, 800]}
              sizes="(max-width: 1023px) 100vw, 640px"
              width={800}
              height={500}
              layout="constrained"
              format="webp"
              class="aspect-[8/5] w-full rounded-2xl object-cover shadow-lg"
              style={lead.focus ? `object-position: ${lead.focus}` : undefined}
            />
            <figcaption class="mt-4">
              <span class="block text-xl font-bold text-heading">{lead.name}</span>
              <span class="block text-base text-muted">{lead.role}</span>
            </figcaption>
          </figure>
          <div class="lg:col-span-5">
            <p class="text-base font-bold tracking-wide text-secondary uppercase">Our staff</p>
            <h2 class="mt-2 font-heading text-3xl leading-tighter font-bold tracking-tighter text-balance text-heading md:text-4xl">
              Years of groundwork. A team to build on it.
            </h2>
            <div class="mt-6 space-y-4 text-lg text-pretty">
              <p>
                Our Executive Director, {lead.name}, known to many neighbors as Aunt Rhonda, has spent years knocking on
                doors, showing up on market day, and carrying neighbors’ voices to the people making decisions. That
                work helped lay the groundwork for what’s happening at Valley Plaza today.
              </p>
              <p>
                But no one rebuilds a neighborhood alone. Rhonda works side by side with our board, our volunteers, and
                our partners, and what comes next will take every one of us.
              </p>
            </div>
          </div>
        </div>
        {otherStaff.length > 0 && (
          <ul class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
            {otherStaff.map((person) => (
              <li>
                <Image
                  src={person.image}
                  alt={person.alt}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 240px"
                  width={480}
                  height={480}
                  layout="constrained"
                  format="webp"
                  class="aspect-square w-full rounded-2xl bg-surface object-cover shadow-md"
                  style={person.focus ? `object-position: ${person.focus}` : undefined}
                />
                <p class="mt-4 text-xl font-bold text-heading">{person.name}</p>
                <p class="text-base text-muted">{person.role}</p>
                {person.bio && <p class="mt-2 text-lg text-pretty text-muted">{person.bio}</p>}
              </li>
            ))}
          </ul>
        )}
      </WidgetWrapper>
    )
  }

  <!-- 3. Board of Directors ******************************************** -->

  <WidgetWrapper id="board">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface"></div>
    </Fragment>
    <Headline
      tagline="Board of Directors"
      title="Neighbors and partners, guiding the work."
      subtitle={`Our board sets ${ORG.shortName}’s direction, holds us accountable, and makes sure neighbors’ priorities come first.`}
      classes={{ container: 'max-w-3xl' }}
    />
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-10">
      {
        BOARD.map((person) => (
          <li class="w-[calc(50%-0.75rem)] sm:w-[calc(33.333%-1rem)] lg:w-[calc(20%-1.2rem)]">
            <Image
              src={person.image}
              alt={person.alt}
              widths={[240, 360, 480]}
              sizes="(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 240px"
              width={480}
              height={480}
              layout="constrained"
              format="webp"
              class="aspect-square w-full rounded-2xl bg-page object-cover shadow-md"
              style={person.focus ? `object-position: ${person.focus}` : undefined}
            />
            <p class="mt-4 text-xl font-bold text-heading">{person.name}</p>
            <p class="text-base text-muted">{person.role}</p>
            {person.bio && <p class="mt-2 text-lg text-pretty text-muted">{person.bio}</p>}
          </li>
        ))
      }
    </ul>
    <p class="mt-12 text-center text-lg">
      <a
        href={ORG.bylawsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-link underline underline-offset-4"
      >
        <Icon name="tabler:file-text" class="h-5 w-5" aria-hidden="true" />
        Read our bylaws<span class="sr-only"> (PDF, opens in a new tab)</span>
      </a>
    </p>
  </WidgetWrapper>

  <!-- 4. Volunteers **************************************************** -->

  <WidgetWrapper id="volunteers">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <p class="text-base font-bold tracking-wide text-secondary uppercase">Our volunteers</p>
        <h2
          class="mt-2 font-heading text-3xl leading-tighter font-bold tracking-tighter text-balance text-heading md:text-4xl"
        >
          Many hands make market day happen.
        </h2>
        <p class="mt-6 text-lg text-pretty">
          Our volunteers come from right here in the Valley/Southside and from all over greater Syracuse. They’re the
          reason the market is ready when neighbors arrive, and the reason it all gets packed away when the day is done.
        </p>
        <div class="mt-8">
          <Button
            variant="secondary"
            text="Volunteer with us"
            href={getPermalink('/get-involved')}
            icon="tabler:arrow-right"
          />
        </div>
      </div>
      <ul class="space-y-4 lg:col-span-6">
        {
          VOLUNTEER_ROLES.map(({ icon, title, description }) => (
            <li class="flex gap-5 rounded-2xl bg-surface p-6">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary">
                <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <div>
                <h3 class="text-xl font-bold text-heading">{title}</h3>
                <p class="mt-1 text-lg text-pretty text-muted">{description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </WidgetWrapper>

  <!-- Next step: together ********************************************** -->

  <CallToAction
    layout="banner"
    title="We got here together. We’ll go further together."
    subtitle={`Since ${STORY.foundedYear}, neighbors showing up week after week helped bring a grocery store and a pharmacy back to Valley Plaza. There’s a place for you in what comes next.`}
    actions={[
      { variant: 'primary', text: 'Get involved', href: getPermalink('/get-involved') },
      { text: 'Donate', href: getPermalink('/donate') },
    ]}
  />
</Layout>
