---
// Zeffy donation form as a popup. Rendered once in Layout.astro; any link to
// /donate (header button, page buttons, footer, post text) opens it instead of
// navigating. Ctrl/Cmd/middle-click still opens /donate normally.
//
// Beside the form (above it on small screens), a short panel names the current
// campaign and what a gift pays for. Its copy lives in DONATE.campaign.
//
// This replaces Zeffy's own embed script (embed-form-script.min.js), which only
// runs on DOMContentLoaded and so breaks after a <ClientRouter /> page
// transition, and which doesn't stop a Donate *link* from also navigating.
// It speaks the same protocol: the `?modal=true` form, an `open` message sent
// to the iframe, and a `close` message sent back by Zeffy's close button.
import { Icon } from 'astro-icon/components';
import { DONATE, ORG, STORY } from '~/data/site';
import { getPermalink } from '~/utils/permalinks';

const formUrl = `${DONATE.zeffyFormUrl}?modal=true`;
const { campaign } = DONATE;
---

<dialog
  id="zeffy-modal"
  transition:persist
  data-form-url={formUrl}
  data-donate-path={getPermalink('/donate')}
  aria-labelledby="zeffy-modal-title"
  class="m-0 p-0 max-w-none max-h-none w-full h-full bg-transparent overflow-y-auto lg:overflow-hidden lg:inset-x-[5%] lg:inset-y-[5%] lg:w-[90%] lg:h-[90%] open:flex flex-col lg:flex-row lg:gap-4"
>
  <section
    class="relative shrink-0 bg-page text-default px-5 pt-6 pb-5 sm:px-8 lg:w-[24rem] lg:rounded-lg lg:p-8 lg:overflow-y-auto"
  >
    <form method="dialog" class="absolute right-3 top-3">
      <button
        type="submit"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-muted hover:bg-surface hover:text-heading focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
        aria-label="Close"
      >
        <Icon name="tabler:x" class="h-5 w-5" />
      </button>
    </form>

    <p class="text-sm font-semibold uppercase tracking-wide text-secondary dark:text-primary">
      Give to {ORG.shortName}
    </p>
    <h2
      id="zeffy-modal-title"
      class="mt-2 pr-10 font-heading text-2xl sm:text-3xl font-bold leading-tight text-heading"
      set:text={campaign.title}
    />
    <p class="mt-3 text-lg leading-relaxed">
      Since {STORY.foundedYear}, neighbors have shown up week after week. Your gift helps that work keep growing.
    </p>

    <p class="mt-5 font-semibold text-heading">Your gift supports:</p>
    <ul class="mt-3 space-y-4">
      {
        campaign.supports.map((item) => (
          <li class="flex gap-3">
            <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface text-primary">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <span class="leading-snug">
              <strong class="block text-heading">{item.title}</strong>
              {item.text}
            </span>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 flex gap-3 rounded-lg bg-surface p-4 leading-snug">
      <Icon name="tabler:home-heart" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
      <span>{campaign.vision}</span>
    </p>

    <p class="mt-5 text-base text-muted">Thank you for growing with us. {ORG.shortName} is a {ORG.taxStatus}.</p>
  </section>

  <iframe
    title="Donation form, powered and secured by Zeffy"
    allow="payment"
    class="w-full min-h-[85dvh] flex-1 border-0 lg:min-h-0 lg:rounded"></iframe>
</dialog>

<style>
  dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  :global(html:has(#zeffy-modal[open])) {
    overflow: hidden;
  }
</style>

<script>
  const ZEFFY_ID = 'zeffy-iframe';

  const getModal = () => document.getElementById('zeffy-modal') as HTMLDialogElement | null;
  const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');

  // A same-site link to /donate, unless we're already on /donate (its inline form takes over there).
  const donateLinkFrom = (target: EventTarget | null) => {
    const modal = getModal();
    const link = (target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
    if (!modal || !link) return null;
    const url = new URL(link.href, location.href);
    const donatePath = norm(modal.dataset.donatePath || '/donate');
    if (url.origin !== location.origin || norm(url.pathname) !== donatePath) return null;
    if (norm(location.pathname) === donatePath) return null;
    return { modal, iframe: modal.querySelector('iframe')! };
  };

  // Load the form the first time someone shows intent (hover, focus, tap), so it's
  // usually ready by the click without every visitor loading Zeffy on every page.
  const load = (iframe: HTMLIFrameElement, modal: HTMLDialogElement) => {
    if (iframe.src) return;
    const url = new URL(modal.dataset.formUrl!);
    url.searchParams.set('cachebust', String(Date.now()));
    iframe.src = url.toString();
    iframe.addEventListener('load', () => {
      if (modal.open) iframe.contentWindow?.postMessage({ id: ZEFFY_ID, open: true }, '*');
    });
  };

  const preload = (e: Event) => {
    const hit = donateLinkFrom(e.target);
    if (hit) load(hit.iframe, hit.modal);
  };
  ['pointerover', 'focusin', 'touchstart'].forEach((type) =>
    document.addEventListener(type, preload, { passive: true })
  );

  // Capture phase, so this runs before the ClientRouter's own link handling.
  document.addEventListener(
    'click',
    (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const hit = donateLinkFrom(e.target);
      if (!hit) return;
      e.preventDefault();
      e.stopPropagation();
      load(hit.iframe, hit.modal);
      hit.modal.showModal();
      hit.modal.scrollTop = 0;
      hit.iframe.contentWindow?.postMessage({ id: ZEFFY_ID, open: true }, '*');
    },
    true
  );

  // Close on a click outside the form (on the dimmed backdrop, or the gap beside the panel).
  document.addEventListener('click', (e) => {
    const modal = getModal();
    if (modal?.open && e.target === modal) modal.close();
  });

  // Zeffy's own close button inside the form asks the page to close it.
  // (Escape is handled natively by <dialog>.)
  window.addEventListener('message', (e) => {
    const modal = getModal();
    if (!modal || e.source !== modal.querySelector('iframe')?.contentWindow) return;
    if (e.data?.id === ZEFFY_ID && e.data.close) modal.close();
  });
</script>
