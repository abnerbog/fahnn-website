---
import { Image } from 'astro:assets';
import { twMerge } from 'tailwind-merge';
import logo from '~/assets/images/logo_fahnn.png';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<Image
  src={logo}
  alt=""
  width={160}
  height={160}
  loading="eager"
  class={twMerge('h-14 w-14 lg:h-16 lg:w-16 rounded-full bg-white ring-1 ring-black/5 dark:ring-white/10', className)}
/>
