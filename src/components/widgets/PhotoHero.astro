---
/**
 * The full-bleed photo hero that opens each main page (Our Story, Our People,
 * …). The title and subtitle sit in the same place on every page, low on the
 * photo over a dark gradient, so moving between tabs feels consistent.
 *
 * The subtitle goes in the default slot.
 */
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

export interface Props {
  image: ImageMetadata;
  /** Describes the scene in the photo. */
  alt: string;
  title: string;
  /** CSS object-position for the crop, when the subject isn't centred. */
  focus?: string;
}

const { image, alt, title, focus = 'center' } = Astro.props;
---

<section class="relative isolate not-prose overflow-hidden bg-black">
  <Image
    src={image}
    alt={alt}
    layout="cover"
    widths={[640, 1024, 1600, 2400].filter((w) => w <= image.width)}
    sizes="100vw"
    width={Math.min(2400, image.width)}
    height={Math.round((Math.min(2400, image.width) * image.height) / image.width)}
    loading="eager"
    fetchpriority="high"
    format="webp"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    style={`object-position: ${focus}`}
  />
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 via-black/35 to-black/0" aria-hidden="true"></div>
  <div
    class="mx-auto flex min-h-[32rem] max-w-7xl flex-col justify-end px-4 pt-48 pb-6 md:min-h-[44rem] md:px-6 md:pb-8 lg:min-h-[min(80vh,56rem)]"
  >
    <h1
      class="max-w-3xl font-heading text-5xl leading-tighter font-bold tracking-tighter text-balance text-white md:text-7xl"
    >
      {title}
    </h1>
    <p class="mt-6 max-w-2xl text-xl text-pretty text-white/90 md:text-2xl">
      <slot />
    </p>
  </div>
</section>
