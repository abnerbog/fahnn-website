---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import { ORG } from '~/data/site';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;

const linkClass =
  'text-muted hover:text-link hover:underline underline-offset-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link';
---

<footer
  class="relative bg-chrome text-default border-t border-gray-200 dark:border-slate-800 not-prose"
  data-pagefind-ignore="all"
>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-8 py-12 md:py-16 text-center">
      <div class="col-span-2 lg:col-span-1 flex justify-center lg:self-center">
        <a
          class="rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link"
          href={getHomePermalink()}
          aria-label={`${ORG.name}: home`}
        >
          <Logo class="h-32 w-32 lg:h-32 lg:w-32" />
        </a>
      </div>
      {
        links.map(({ title, links }) => (
          <nav aria-label={title}>
            <h2 class="font-heading text-lg font-bold text-heading mb-3">{title}</h2>
            {links?.length > 0 && (
              <ul>
                {links.map(({ text, href, ariaLabel, target }) => (
                  <li class="mb-2.5">
                    <a
                      class={linkClass}
                      href={href}
                      aria-label={ariaLabel}
                      {...(target ? { target, rel: 'noopener noreferrer' } : {})}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </nav>
        ))
      }
      {
        socialLinks?.length ? (
          <div class="col-span-2 lg:col-span-1">
            <h2 class="font-heading text-lg font-bold text-heading mb-3">Follow along</h2>
            <ul class="flex justify-center gap-2">
              {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                <li>
                  <a
                    class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-gray-100 text-default hover:text-link hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
                    aria-label={ariaLabel}
                    href={href}
                  >
                    {icon && <Icon name={icon} class="w-6 h-6" aria-hidden="true" />}
                    <Fragment set:html={text} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          ''
        )
      }
    </div>
    <div
      class="flex flex-col items-center gap-3 border-t border-gray-200 dark:border-slate-800 py-6 text-center text-sm text-muted"
    >
      <p>
        <Fragment set:html={`© ${new Date().getFullYear()} ${footNote}`} />
        {
          secondaryLinks.map(({ text, href }) => (
            <>
              {' · '}
              <a class={linkClass} href={href} set:html={text} />
            </>
          ))
        }
      </p>
      <ToggleTheme
        class="inline-flex items-center rounded-lg p-2 text-muted hover:bg-gray-100 hover:text-link dark:hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-link"
        iconClass="w-5 h-5"
      />
    </div>
  </div>
</footer>
